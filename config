# =============================================================================
# Sway Configuration (monkey-sway)
# Sonokai Dark Theme | Vim-style Keybindings | Single-file Config
# =============================================================================
#
# Environment (sway itself cannot export these; export them in your shell rc
# before launching sway, e.g.:
#
#   export XDG_CURRENT_DESKTOP=sway
#   export XDG_SESSION_TYPE=wayland
#   export XDG_SESSION_DESKTOP=sway
#   export QT_QPA_PLATFORM="wayland;xcb"
#   export QT_QPA_PLATFORMTHEME=qt6ct
#   export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
#   export GDK_BACKEND="wayland,x11"
#   export GDK_DPI_SCALE=1
#   export ELECTRON_OZONE_PLATFORM_HINT=auto
#   export XCURSOR_SIZE=24
#
# (If sway is started by a systemd-managed session/display-manager, put the
# same K=V lines into ~/.config/environment.d/90-monkey-sway.conf instead.)
# =============================================================================

# -----------------------------------------------------------------------------
# Variables
# -----------------------------------------------------------------------------
set $mod Mod4

# Default terminal / application launcher
set $term wezterm
set $menu bemenu-run

# Audio volume cap (1.0 = 100%, 1.5 = 150%)
set $vol_cap -l 1.5

# Resize step used by $mod+Shift+hjkl and the resize mode (px or ppt)
set $resize_step 20px

# Screen locker (Sonokai colors) — used by the lock key and swayidle
set $lock swaylock --color 2c2e34 --ring-color 363944 --inside-color 2c2e34 \
  --line-color 2c2e34 --separator-color 2c2e34 --text-color e2e2e3 \
  --key-hl-color 76cce0 --bs-hl-color fc5d7c --font monospace \
  --ring-ver-color 354157 --inside-ver-color 354157 --text-ver-color e2e2e3 \
  --ring-wrong-color 55393d --inside-wrong-color 55393d --text-wrong-color fc5d7c \
  --ring-clear-color 4e432f --inside-clear-color 4e432f --text-clear-color e2e2e3

# -----------------------------------------------------------------------------
# Looks (Sonokai)
# -----------------------------------------------------------------------------
font pango:JetBrains Mono 12

# Wallpaper: same picture as monkey-hyprland (sway spawns swaybg
# automatically). "fill" scales and crops to cover each output.
# The pictures/ directory is symlinked to ~/.config/sway by install.sh,
# so the path below works regardless of where the repo is cloned.
output * bg ~/.config/sway/pictures/oskar-kadaksoo-ZqJ7zs0iT7w-unsplash.jpg fill

# Borders / gaps
default_border pixel 2
default_floating_border pixel 2
gaps inner 0
gaps outer 0

# Border & title colors (border, background, text, indicator, child_border)
client.focused            #76cce0 #33353f #e2e2e3 #b39df3 #76cce0
client.focused_inactive   #595f6f #363944 #7f8490 #595f6f #595f6f
client.unfocused          #595f6f #2c2e34 #595f6f #595f6f #595f6f
client.urgent             #fc5d7c #55393d #e2e2e3 #fc5d7c #fc5d7c
client.placeholder        #595f6f #2c2e34 #7f8490 #595f6f #595f6f
client.focused_tab_title  #595f6f #363944 #e2e2e3

# -----------------------------------------------------------------------------
# Input
# -----------------------------------------------------------------------------
input "type:keyboard" {
  xkb_layout us
}

input "type:touchpad" {
  natural_scroll enabled
}

focus_follows_mouse yes
focus_wrapping yes

# Hold $mod + left drag to move a floating window, right drag to resize it
floating_modifier $mod

# -----------------------------------------------------------------------------
# Monitors
# Auto-detect every monitor at its highest refresh rate. Sway naturally does
# this; fractional scaling is not auto-selected (sets itself is done per-output
# with `output <name> scale X` if needed).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Autostart
# -----------------------------------------------------------------------------
exec_always pgrep -x waybar || waybar &
exec_always pgrep -x mako || mako &
exec_always pgrep -x polkit-gnome-authentication-agent-1 || /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
exec_always pgrep -x xdg-desktop-portal-wlr || /usr/lib/xdg-desktop-portal-wlr &
exec_always pgrep -x xdg-desktop-portal-gtk || /usr/lib/xdg-desktop-portal-gtk &
exec_always pgrep -x swayidle || swayidle -w timeout 300 "$lock" timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' before-sleep "$lock" &
exec_always pgrep -x nm-applet || nm-applet &

# -----------------------------------------------------------------------------
# Keybindings
# -----------------------------------------------------------------------------
# The "Super" key below means the Windows/Command key ($mod).

# --- Window focus (Vim-style) ---
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# --- Move windows ($mod+Ctrl+hjkl) ---
bindsym $mod+Ctrl+h move left
bindsym $mod+Ctrl+j move down
bindsym $mod+Ctrl+k move up
bindsym $mod+Ctrl+l move right

# --- Resize windows ($mod+Shift+hjkl) ---
bindsym $mod+Shift+h resize shrink width $resize_step
bindsym $mod+Shift+j resize grow height $resize_step
bindsym $mod+Shift+k resize shrink height $resize_step
bindsym $mod+Shift+l resize grow width $resize_step

# --- Arrow key alternatives for focus / move / resize ---
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+Ctrl+Left move left
bindsym $mod+Ctrl+Right move right
bindsym $mod+Ctrl+Up move up
bindsym $mod+Ctrl+Down move down

bindsym $mod+Shift+Left resize shrink width $resize_step
bindsym $mod+Shift+Right resize grow width $resize_step
bindsym $mod+Shift+Up resize shrink height $resize_step
bindsym $mod+Shift+Down resize grow height $resize_step

# --- Dedicated resize mode ($mod+r, Esc/Return to exit) ---
mode "resize" {
  bindsym h resize shrink width $resize_step
  bindsym j resize grow height $resize_step
  bindsym k resize shrink height $resize_step
  bindsym l resize grow width $resize_step
  bindsym Left resize shrink width $resize_step
  bindsym Down resize grow height $resize_step
  bindsym Up resize shrink height $resize_step
  bindsym Right resize grow width $resize_step
  bindsym Escape mode "default"
  bindsym Return mode "default"
}
bindsym $mod+r mode "resize"

# --- Workspace switch ($mod+1~9) and move-to-workspace ($mod+Shift+1~9) ---
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9

# --- Scroll through workspaces ($mod+scroll, down = next) ---
bindsym $mod+button4 workspace prev
bindsym $mod+button5 workspace next

# --- Scratchpad (sway equivalent of Hyprland's special workspace "magic") ---
bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad

# --- Applications & window actions ---
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+c kill
bindsym $mod+v floating toggle
# $mod+p pseudo-tiling had no sway equivalent and was dropped
bindsym $mod+t layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+Ctrl+p sticky toggle

# --- Monitor navigation (spatial left/right; sway has no cycle prev/next) ---
bindsym $mod+bracketleft focus output left
bindsym $mod+bracketright focus output right
bindsym $mod+Shift+bracketleft move window to output left
bindsym $mod+Shift+bracketright move window to output right

# --- Mouse bindings ---
# Dragging / resizing floating windows with $mod held is handled by
# `floating_modifier` above. Scroll-to-switch-workspace is above.

# --- Lock screen / exit (with swaynag confirm) ---
bindsym $mod+Escape exec $lock
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -b 'Exit' 'swaymsg exit'

# --- Media keys (volume, via wpctl) ---
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume $vol_cap @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# --- Brightness keys (harmless on desktops without backlight) ---
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

# --- Screenshots (grim + slurp + wl-clipboard) ---
bindsym $mod+comma exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+comma exec grim - | wl-copy

# -----------------------------------------------------------------------------
# Window rules
# -----------------------------------------------------------------------------

# Do not focus blank XWayland drag shadows (fixes drag regressions)
no_focus [shell="xwayland" class="^$" title="^$"]

# Float utility apps, centered. Sway criteria are case-sensitive and separate:
# app_id matches Wayland-native windows, class matches XWayland ones. Both
# rules are emitted per tool; silent non-matches are harmless.
for_window [app_id="Calculator"] floating enable, move position center
for_window [class="Calculator"] floating enable, move position center
for_window [app_id="gnome-calendar"] floating enable, move position center
for_window [class="gnome-calendar"] floating enable, move position center
for_window [app_id="pavucontrol"] floating enable, move position center
for_window [class="pavucontrol"] floating enable, move position center
for_window [app_id="nm-connection-editor"] floating enable, move position center
for_window [class="nm-connection-editor"] floating enable, move position center
for_window [app_id="blueman-manager"] floating enable, move position center
for_window [class="blueman-manager"] floating enable, move position center
for_window [app_id="file-roller"] floating enable, move position center
for_window [class="file-roller"] floating enable, move position center
for_window [app_id="ark"] floating enable, move position center
for_window [class="ark"] floating enable, move position center
for_window [app_id="gnome-font-viewer"] floating enable, move position center
for_window [class="gnome-font-viewer"] floating enable, move position center
for_window [app_id="arandr"] floating enable, move position center
for_window [class="arandr"] floating enable, move position center
for_window [app_id="veracrypt"] floating enable, move position center
for_window [class="veracrypt"] floating enable, move position center
for_window [app_id="fileprogress"] floating enable, move position center
for_window [class="fileprogress"] floating enable, move position center
for_window [app_id="gcr-prompter"] floating enable, move position center
for_window [class="gcr-prompter"] floating enable, move position center
for_window [app_id="gnome-shell"] floating enable, move position center
for_window [class="gnome-shell"] floating enable, move position center
for_window [app_id="kleo"] floating enable, move position center
for_window [class="kleo"] floating enable, move position center
for_window [app_id="org.gnome.Settings"] floating enable, move position center
for_window [class="org.gnome.Settings"] floating enable, move position center
for_window [app_id="org.gnome.tweaks"] floating enable, move position center
for_window [class="org.gnome.tweaks"] floating enable, move position center
for_window [app_id="pwvucontrol"] floating enable, move position center
for_window [class="pwvucontrol"] floating enable, move position center
for_window [app_id="qalculate-gtk"] floating enable, move position center
for_window [class="qalculate-gtk"] floating enable, move position center
for_window [app_id="qt5ct"] floating enable, move position center
for_window [class="qt5ct"] floating enable, move position center
for_window [app_id="qt6ct"] floating enable, move position center
for_window [class="qt6ct"] floating enable, move position center
for_window [app_id="slack"] floating enable, move position center
for_window [class="slack"] floating enable, move position center
for_window [app_id="solaar"] floating enable, move position center
for_window [class="solaar"] floating enable, move position center
for_window [app_id="thunar"] floating enable, move position center
for_window [class="thunar"] floating enable, move position center
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, move position center
for_window [class="xdg-desktop-portal-gtk"] floating enable, move position center
for_window [app_id="xdg-desktop-portal-wlr"] floating enable, move position center
for_window [class="xdg-desktop-portal-wlr"] floating enable, move position center
for_window [app_id="zenity"] floating enable, move position center
for_window [class="zenity"] floating enable, move position center

# Picture-in-Picture: float and stick it to this output (sway "pin" equivalent)
for_window [title="Picture-in-Picture"] floating enable, sticky enable

# File progress dialogs
for_window [title="File Operation Progress"] floating enable, move position center

# NOTE: sway has no per-window opacity, no blur, no border rounding and no
# dwindle/pseudo layouts. Those Hyprland features are intentionally dropped.
